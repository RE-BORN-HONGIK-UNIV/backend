# backend/.env.example
# 이 파일을 복사해 backend/.env 로 저장하고 실제 값을 채워넣으세요.
# .env는 .gitignore에 포함되어 있어 커밋되지 않습니다 — 절대 실제 값을 커밋하지 마세요.

# 로컬 MySQL 접속 정보 (본인 MySQL root 비밀번호 등으로 교체)
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost/reborn_db

# JWT 서명에 쓰는 키 — 예측 불가능한 임의의 긴 문자열로 설정
# 생성 예: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_RANDOM_SECRET_KEY

# 아래는 선택사항 (없어도 폴백 동작함)
# ANTHROPIC_API_KEY=
# FEEDBACK_MODEL=claude-sonnet-5
# MODEL_PATH=best_size_large.pth
