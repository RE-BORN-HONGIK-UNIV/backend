# backend/.env.example
# 이 파일을 복사해 backend/.env 로 저장하고 실제 값을 채워넣으세요.
# .env는 .gitignore에 포함되어 있어 커밋되지 않습니다 — 절대 실제 값을 커밋하지 마세요.

# PostgreSQL 접속 정보 (본인 비밀번호 등으로 교체). Render는 매니지드 MySQL을
# 지원하지 않아서(Postgres/Redis만) 2026-09에 MySQL→Postgres로 옮김 — 로컬도 이
# 형식(postgresql+psycopg2://)으로 맞춰야 배포 환경과 동일하게 테스트된다.
# Render Postgres를 쓰면 대시보드가 이 형식의 URL을 그대로 내려줌(Internal Database URL).
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost/reborn_db

# JWT 서명에 쓰는 키 — 예측 불가능한 임의의 긴 문자열로 설정
# 생성 예: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_RANDOM_SECRET_KEY

# 아래는 선택사항 (없어도 폴백 동작함)
# ANTHROPIC_API_KEY=
# FEEDBACK_MODEL=claude-sonnet-5
# MODEL_PATH=best_size_large.pth
